{
  "name": "editable-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Inline visual editing plugin for React/Next.js",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r --if-present lint",
