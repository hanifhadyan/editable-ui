{
  "name": "@editable-ui/adapter-pg",
  "version": "0.0.6",
  "license": "MIT",
  "files": ["dist"],
  "description": "PostgreSQL adapter for editable-ui",
  "repository": { "type": "git", "url": "git+https://github.com/hanifhadyan/editable-ui.git" },
  "homepage": "https://github.com/hanifhadyan/editable-ui#readme",
  "bugs": { "url": "https://github.com/hanifhadyan/editable-ui/issues" },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@editable-ui/core": "workspace:*",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
