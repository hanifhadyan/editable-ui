{
  "name": "@editable-ui/adapter-sqlite",
  "version": "0.1.0",
  "license": "MIT",
  "files": ["dist"],
  "description": "SQLite adapter for editable-ui",
  "repository": { "type": "git", "url": "git+https://github.com/hanifhadyan/editable-ui.git" },
  "homepage": "https://github.com/hanifhadyan/editable-ui#readme",
  "bugs": { "url": "https://github.com/hanifhadyan/editable-ui/issues" },
  "engines": { "node": "20.x || 22.x || 23.x || 24.x || 25.x || 26.x" },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@editable-ui/core": "workspace:*",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
